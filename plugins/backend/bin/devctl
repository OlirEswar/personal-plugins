#!/usr/bin/env python3
"""devctl - run dev servers (API, frontend, workers) in the background with plain log files (stdlib only).

Lets Claude and a human share the same running processes: start them once, read their logs,
restart one without touching the other. State lives in <project>/.dev/ (git-ignored).

  devctl start api --port 8787 --cwd api -- npm run dev      # waits until the port answers
  devctl start web --port 5173 --cwd web -- npm run dev
  devctl status                                              # name, pid, port, up/down, uptime
  devctl logs api [-n 80] [--grep ERROR]                     # tail .dev/logs/api.log
  devctl restart api
  devctl stop api | devctl stop all
  devctl wait http://localhost:8787/api/health [--timeout 30]

Humans: `tail -f .dev/logs/api.log`, or stop everything with `devctl stop all`.
"""
import argparse
import json
import os
import re
import shlex
import signal
import socket
import subprocess
import sys
import time
import urllib.request
from pathlib import Path


def project_root() -> Path:
    env = os.environ.get("CLAUDE_PROJECT_DIR")
    if env:
        return Path(env)
    try:
        out = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True)
        return Path(out.stdout.strip())
    except Exception:
        return Path.cwd()


ROOT = project_root()
STATE = ROOT / ".dev"
LOGS = STATE / "logs"


def ensure_state():
    LOGS.mkdir(parents=True, exist_ok=True)
    gi = STATE / ".gitignore"
    if not gi.exists():
        gi.write_text("*\n")


def state_file(name: str) -> Path:
    return STATE / f"{name}.json"


def load(name: str):
    f = state_file(name)
    return json.loads(f.read_text()) if f.exists() else None


def all_names():
    return sorted(p.stem for p in STATE.glob("*.json")) if STATE.exists() else []


def alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def port_open(port: int) -> bool:
    for host in ("127.0.0.1", "::1"):
        fam = socket.AF_INET6 if ":" in host else socket.AF_INET
        try:
            with socket.socket(fam, socket.SOCK_STREAM) as s:
                s.settimeout(0.3)
                if s.connect_ex((host, port)) == 0:
                    return True
        except OSError:
            pass
    return False


def who_has_port(port: int) -> str:
    try:
        out = subprocess.run(["lsof", "-nP", f"-iTCP:{port}", "-sTCP:LISTEN"], capture_output=True, text=True)
        return out.stdout.strip() or "unknown process"
    except FileNotFoundError:
        return "unknown process (lsof not installed)"


def tail(path: Path, n: int, pattern=None) -> str:
    if not path.exists():
        return "(no log yet)"
    lines = path.read_text(errors="replace").splitlines()
    if pattern:
        rx = re.compile(pattern, re.I)
        lines = [l for l in lines if rx.search(l)]
    return "\n".join(lines[-n:])


def wait_ready(proc: subprocess.Popen, port, timeout: float) -> bool:
    start = time.time()
    while time.time() - start < timeout:
        if proc.poll() is not None:  # exited (poll also reaps it, so it isn't a zombie)
            return False
        if port and port_open(port):
            return True
        if not port and time.time() - start > 2:
            return True  # no port to check: still alive after 2s counts as started
        time.sleep(0.3)
    return False


def cmd_start(a):
    if not a.command:
        sys.exit("error: give the command after --, e.g. devctl start api --port 8787 -- npm run dev")
    ensure_state()
    old = load(a.name)
    if old and alive(old["pid"]):
        print(f"{a.name} is already running (pid {old['pid']}). Use `devctl restart {a.name}`.")
        return
    if a.port and port_open(a.port):
        sys.exit(f"error: port {a.port} is already in use:\n{who_has_port(a.port)}")
    cwd = (ROOT / a.cwd).resolve() if a.cwd else ROOT
    log = LOGS / f"{a.name}.log"
    cmd = shlex.join(a.command) if len(a.command) > 1 else a.command[0]
    with open(log, "ab") as fh:
        fh.write(f"\n===== devctl start {a.name} @ {time.strftime('%Y-%m-%d %H:%M:%S')}: {cmd} (cwd {cwd})\n".encode())
        fh.flush()
        env = {**os.environ, "FORCE_COLOR": "0", "NO_COLOR": "1"}
        if a.port:
            env.setdefault("PORT", str(a.port))
        proc = subprocess.Popen(cmd, shell=True, cwd=cwd, stdout=fh, stderr=subprocess.STDOUT,
                                stdin=subprocess.DEVNULL, start_new_session=True, env=env)
    st = {"name": a.name, "pid": proc.pid, "port": a.port, "cwd": str(cwd), "command": cmd,
          "log": str(log.relative_to(ROOT)), "started": time.time()}
    state_file(a.name).write_text(json.dumps(st, indent=2))
    if wait_ready(proc, a.port, a.timeout):
        where = f" on http://localhost:{a.port}" if a.port else ""
        print(f"{a.name} started (pid {proc.pid}){where}. Logs: {st['log']}")
    else:
        status = f"exited with code {proc.returncode}" if proc.poll() is not None else f"did not open port {a.port} within {a.timeout:.0f}s (still running; check the log)"
        print(f"{a.name} {status}. Last log lines:\n{tail(log, 30)}", file=sys.stderr)
        sys.exit(1)


def stop_one(name: str, quiet=False):
    st = load(name)
    if not st:
        if not quiet:
            print(f"{name}: not managed by devctl")
        return
    pid = st["pid"]
    if alive(pid):
        try:
            os.killpg(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        for _ in range(50):
            if not alive(pid):
                break
            time.sleep(0.1)
        else:
            try:
                os.killpg(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
    state_file(name).unlink(missing_ok=True)
    print(f"{name} stopped")


def cmd_stop(a):
    names = all_names() if a.name == "all" else [a.name]
    for n in names:
        stop_one(n)


def cmd_restart(a):
    st = load(a.name)
    if not st:
        sys.exit(f"error: {a.name} was never started with devctl")
    stop_one(a.name, quiet=True)
    if st.get("port"):
        for _ in range(50):
            if not port_open(st["port"]):
                break
            time.sleep(0.1)
    ns = argparse.Namespace(name=a.name, port=st.get("port"), cwd=st["cwd"], command=[st["command"]],
                            timeout=a.timeout)
    cmd_start(ns)


def cmd_status(a):
    names = all_names()
    if not names:
        print("No devctl processes. Start one: devctl start <name> --port <p> -- <command>")
        return
    print(f"{'NAME':<12} {'PID':>7}  {'STATE':<8} {'PORT':<6} {'UPTIME':<9} COMMAND")
    for n in names:
        st = load(n)
        up = alive(st["pid"])
        port = st.get("port") or "-"
        state = "running" if up and (not st.get("port") or port_open(st["port"])) else ("starting" if up else "DEAD")
        secs = int(time.time() - st["started"])
        uptime = f"{secs // 3600}h{secs % 3600 // 60:02d}m" if secs >= 3600 else f"{secs // 60}m{secs % 60:02d}s"
        print(f"{n:<12} {st['pid']:>7}  {state:<8} {str(port):<6} {uptime:<9} {st['command']}  (cwd {st['cwd']})")
        if state == "DEAD":
            print(f"{'':<12} last log lines:\n" + "\n".join("    " + l for l in tail(ROOT / st["log"], 8).splitlines()))


def cmd_logs(a):
    print(tail(LOGS / f"{a.name}.log", a.n, a.grep))


def cmd_wait(a):
    target = a.target
    deadline = time.time() + a.timeout
    while time.time() < deadline:
        if target.isdigit():
            if port_open(int(target)):
                print(f"port {target} is open")
                return
        else:
            try:
                with urllib.request.urlopen(target, timeout=2) as r:
                    print(f"{target} -> {r.status}")
                    return
            except urllib.error.HTTPError as e:
                if e.code < 500:
                    print(f"{target} -> {e.code}")
                    return
            except Exception:
                pass
        time.sleep(0.5)
    sys.exit(f"error: {target} not ready after {a.timeout:.0f}s")


def main():
    p = argparse.ArgumentParser(prog="devctl", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("start", help="start a named background process")
    s.add_argument("name")
    s.add_argument("--port", type=int, help="port the process listens on (waits for it; sets PORT if unset)")
    s.add_argument("--cwd", help="working directory, relative to the project root")
    s.add_argument("--timeout", type=float, default=60)
    s.set_defaults(fn=cmd_start, command=[])
    s = sub.add_parser("stop", help="stop a process (or `all`)")
    s.add_argument("name")
    s.set_defaults(fn=cmd_stop)
    s = sub.add_parser("restart", help="restart with the same command")
    s.add_argument("name")
    s.add_argument("--timeout", type=float, default=60)
    s.set_defaults(fn=cmd_restart)
    sub.add_parser("status", help="list processes").set_defaults(fn=cmd_status)
    s = sub.add_parser("logs", help="show the end of a process's log")
    s.add_argument("name")
    s.add_argument("-n", type=int, default=50)
    s.add_argument("--grep", help="only lines matching this regex")
    s.set_defaults(fn=cmd_logs)
    s = sub.add_parser("wait", help="wait for a URL or port to answer")
    s.add_argument("target")
    s.add_argument("--timeout", type=float, default=30)
    s.set_defaults(fn=cmd_wait)
    argv = sys.argv[1:]
    command = []
    if "--" in argv:  # everything after -- is the command to run, untouched
        i = argv.index("--")
        argv, command = argv[:i], argv[i + 1:]
    a = p.parse_args(argv)
    if a.cmd == "start":
        a.command = command
    a.fn(a)


if __name__ == "__main__":
    main()
