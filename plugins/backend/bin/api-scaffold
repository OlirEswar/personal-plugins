#!/usr/bin/env python3
"""api-scaffold - create a working TypeScript REST API from the backend setup's template (stdlib only).

  api-scaffold                         # ./api with SQLite (zero setup)
  api-scaffold api --db postgres       # Postgres in Docker
  api-scaffold api --db postgres --mongo
  api-scaffold server --port 8788 --web-origin http://localhost:3000

Stack: Node 22.18+ (runs .ts directly), Hono, @hono/zod-openapi, Drizzle ORM, vitest.
Includes cookie-session auth, an example CRUD resource, problem+json errors, OpenAPI docs at
/api/docs, rate limiting, security headers, CSRF/CORS, and tests. Picks free ports if the
defaults are taken. Never overwrites an existing non-empty directory.
"""
import argparse
import json
import re
import shutil
import socket
import sys
from pathlib import Path

TEMPLATE = Path(__file__).resolve().parent.parent / "templates" / "api"
VARIANTS = ("sqlite", "postgres", "mongo")

# Versions verified together; bump deliberately and re-run the template tests.
DEPS = {
    "@hono/node-server": "^2.1.7",
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-openapi": "^1.6.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "zod": "^4.6.7",
}
DB_DEPS = {"sqlite": {"@libsql/client": "^0.18.0"}, "postgres": {"postgres": "^4.1.1"}}
MONGO_DEPS = {"mongodb": "^7.8.0"}
DEV_DEPS = {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
}
ENV_FLAG = "--env-file-if-exists=.env"


def port_free(port: int) -> bool:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            s.bind(("127.0.0.1", port))
            return True
        except OSError:
            return False


def pick_port(preferred: int, label: str, taken: set) -> int:
    port = preferred
    while not port_free(port) or port in taken:
        port += 1
    if port != preferred:
        print(f"  {label}: port {preferred} is busy, using {port}")
    taken.add(port)
    return port


def render(text: str, active: set, subs: dict) -> str:
    # Block markers (Markdown): <!-- scaffold:x --> ... <!-- /scaffold:x -->
    def block(m):
        return m.group(2) if m.group(1) in active else ""
    text = re.sub(r"<!-- scaffold:(\w+) -->\n(.*?)<!-- /scaffold:\1 -->\n", block, text, flags=re.S)
    # Line markers (code): keep the line without the marker if active, else drop the line.
    out = []
    for line in text.splitlines(keepends=True):
        m = re.search(r"\s*// scaffold:(\w+)\s*$", line)
        if m:
            if m.group(1) in active:
                out.append(line[: m.start()] + "\n")
            continue
        out.append(line)
    text = "".join(out)
    for k, v in subs.items():
        text = text.replace(k, str(v))
    return text


def target_name(rel: Path, active: set):
    """schema.sqlite.ts -> schema.ts if sqlite active, else None (skip)."""
    parts = rel.name.split(".")
    if len(parts) >= 3 and parts[-2] in VARIANTS:
        if parts[-2] not in active:
            return None
        return rel.with_name(".".join(parts[:-2] + parts[-1:]))
    if rel.name in ("gitignore", "dockerignore"):
        return rel.with_name("." + rel.name)
    return rel


def compose_file(project: str, db: str, mongo: bool, pg_port: int, mongo_port: int) -> str:
    lines = [f"# Local databases for development. Start: docker compose up -d   Stop: docker compose stop",
             f"# Data lives in named volumes; `docker compose down -v` DELETES it.",
             f"name: {project}", "services:"]
    vols = []
    if db == "postgres":
        lines += [
            "  postgres:",
            "    image: postgres:18-alpine",
            "    environment:",
            "      POSTGRES_USER: app",
            "      POSTGRES_PASSWORD: app",
            "      POSTGRES_DB: app",
            "    ports:",
            f'      - "127.0.0.1:{pg_port}:5432"',
            "    volumes:",
            "      - pgdata:/var/lib/postgresql",
            "      - ./docker/postgres-init.sql:/docker-entrypoint-initdb.d/init.sql:ro",
            "    healthcheck:",
            '      test: ["CMD-SHELL", "pg_isready -U app -d app"]',
            "      interval: 2s",
            "      timeout: 3s",
            "      retries: 15",
        ]
        vols.append("pgdata")
    if mongo:
        lines += [
            "  mongo:",
            "    # mongo:8 refuses to start on Docker VMs with Linux 6.19-7.0.13 (SERVER-121912); 7.0 runs everywhere.",
            "    image: mongo:7.0",
            "    ports:",
            f'      - "127.0.0.1:{mongo_port}:27017"',
            "    volumes:",
            "      - mongodata:/data/db",
            "    healthcheck:",
            '      test: ["CMD", "mongosh", "--quiet", "--eval", "db.adminCommand({ ping: 1 })"]',
            "      interval: 2s",
            "      timeout: 5s",
            "      retries: 15",
        ]
        vols.append("mongodata")
    lines += ["volumes:"] + [f"  {v}:" for v in vols]
    return "\n".join(lines) + "\n"


def ci_workflow(api_dir: str, db: str, mongo: bool) -> str:
    """GitHub Actions: typecheck, migrations, tests, contract drift, audit, docker build."""
    services = []
    env = ["      NODE_ENV: test", "      TRUST_PROXY: 1", "      WEB_ORIGIN: http://localhost:5173"]
    if db == "postgres":
        services += [
            "      postgres:",
            "        image: postgres:18-alpine",
            "        env: { POSTGRES_USER: app, POSTGRES_PASSWORD: app, POSTGRES_DB: app_test }",
            '        ports: ["5432:5432"]',
            "        options: >-",
            "          --health-cmd \"pg_isready -U app -d app_test\" --health-interval 2s --health-timeout 3s --health-retries 15",
        ]
        env.append("      DATABASE_URL: postgres://app:app@localhost:5432/app_test")
    else:
        env.append("      DATABASE_URL: file:./data/test.db")
    if mongo:
        services += [
            "      mongo:",
            "        image: mongo:7.0",
            '        ports: ["27017:27017"]',
        ]
        env.append("      MONGODB_URL: mongodb://localhost:27017/app_test")
    lines = [
        f"# CI for {api_dir}/ (generated by api-scaffold). Runs on every push and pull request.",
        f"name: {api_dir}",
        "on:",
        "  push:",
        f'    paths: ["{api_dir}/**", ".github/workflows/{api_dir}.yml"]',
        "  pull_request:",
        f'    paths: ["{api_dir}/**", ".github/workflows/{api_dir}.yml"]',
        "jobs:",
        "  check:",
        "    runs-on: ubuntu-latest",
        "    defaults:",
        "      run:",
        f"        working-directory: {api_dir}",
    ]
    if services:
        lines += ["    services:"] + services
    lines += ["    env:"] + env + [
        "    steps:",
        "      - uses: actions/checkout@v4",
        "      - uses: actions/setup-node@v4",
        "        with:",
        "          node-version: 24",
        "          cache: npm",
        f"          cache-dependency-path: {api_dir}/package-lock.json",
        "      - run: npm ci",
        "      - run: npm run typecheck",
        "      - name: Migrations are committed for every schema change",
        "        run: |",
        "          npx drizzle-kit check",
        "          npx drizzle-kit generate",
        '          if [ -n "$(git status --porcelain drizzle/)" ]; then echo "::error::schema.ts changed without a committed migration: run npm run db:generate"; git status --porcelain drizzle/; exit 1; fi',
        "      - run: npm test",
        "      - name: openapi.json matches the code (the frontend's contract)",
        "        run: |",
        "          npm run openapi",
        '          if [ -n "$(git status --porcelain openapi.json)" ]; then echo "::error::openapi.json is stale or uncommitted: run npm run openapi"; git diff openapi.json | head -50; exit 1; fi',
        "      - name: No known high-severity vulnerabilities in runtime dependencies",
        "        run: npm audit --omit=dev --audit-level=high",
        "      - name: Production image builds",
        "        run: docker build -t api-ci .",
    ]
    return "\n".join(lines) + "\n"


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("dir", nargs="?", default="api", help="where to create the API (default: ./api)")
    p.add_argument("--db", choices=["sqlite", "postgres"], default="sqlite")
    p.add_argument("--mongo", action="store_true", help="add MongoDB (Docker) with an example notes resource")
    p.add_argument("--port", type=int, default=8787, help="API port (default 8787)")
    p.add_argument("--web-origin", default="http://localhost:5173",
                   help="frontend origin(s), comma-separated (default: Vite's http://localhost:5173)")
    p.add_argument("--name", help="package/compose name (default: <project>-<dir>)")
    p.add_argument("--no-ci", action="store_true", help="don't write .github/workflows/<dir>.yml")
    a = p.parse_args()

    dest = Path(a.dir).resolve()
    if dest.exists() and any(dest.iterdir()):
        sys.exit(f"error: {dest} already exists and is not empty")
    if not TEMPLATE.is_dir():
        sys.exit(f"error: template not found at {TEMPLATE}")
    if a.db == "postgres" or a.mongo:
        if not shutil.which("docker"):
            print("warning: docker not found; Postgres/Mongo run via `docker compose`", file=sys.stderr)

    slug = lambda s: re.sub(r"[^a-z0-9-]+", "-", s.lower()).strip("-") or "app"
    name = slug(a.name or f"{dest.parent.name}-{dest.name}")
    active = {a.db} | ({"mongo"} if a.mongo else set()) | ({"docker"} if a.db == "postgres" or a.mongo else set())

    taken: set = set()
    port = pick_port(a.port, "API", taken)
    pg_port = pick_port(5432, "Postgres", taken) if a.db == "postgres" else 5432
    mongo_port = pick_port(27017, "MongoDB", taken) if a.mongo else 27017
    subs = {"__PORT__": port, "__NAME__": name}

    for src in sorted(TEMPLATE.rglob("*")):
        if src.is_dir() or src.name in (".DS_Store",) or "node_modules" in src.parts:
            continue
        rel = target_name(src.relative_to(TEMPLATE), active)
        if rel is None:
            continue
        out = dest / rel
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(render(src.read_text(), active, subs))

    deps = {**DEPS, **DB_DEPS[a.db], **(MONGO_DEPS if a.mongo else {})}
    pkg = {
        "name": name,
        "private": True,
        "type": "module",
        "engines": {"node": ">=22.18"},
        "scripts": {
            "dev": f"node --watch {ENV_FLAG} src/index.ts",
            "start": f"node {ENV_FLAG} src/index.ts",
            "test": "vitest run",
            "test:watch": "vitest",
            "typecheck": "tsc",
            "db:generate": "drizzle-kit generate",
            "db:migrate": f"node {ENV_FLAG} src/db/migrate.ts",
            "db:seed": f"node {ENV_FLAG} src/db/seed.ts",
            "db:studio": "drizzle-kit studio",
            "openapi": f"node {ENV_FLAG} src/scripts/openapi.ts",
            "worker": f"node {ENV_FLAG} src/worker.ts",
        },
        "dependencies": dict(sorted(deps.items())),
        "devDependencies": dict(sorted(DEV_DEPS.items())),
    }
    (dest / "package.json").write_text(json.dumps(pkg, indent=2) + "\n")

    if a.db == "sqlite":
        db_url, test_db_url = "file:./data/app.db", "file:./data/test.db"
    else:
        db_url = f"postgres://app:app@127.0.0.1:{pg_port}/app"
        test_db_url = f"postgres://app:app@127.0.0.1:{pg_port}/app_test"
        (dest / "docker").mkdir(exist_ok=True)
        (dest / "docker/postgres-init.sql").write_text(
            "-- Runs once when the Postgres volume is first created.\nCREATE DATABASE app_test;\n")
    env_lines = [
        "# Local development settings. Copy to .env (git-ignored). Never commit real secrets.",
        "NODE_ENV=development",
        f"PORT={port}",
        f"DATABASE_URL={db_url}",
        f"WEB_ORIGIN={a.web_origin}",
        "# Public URL of the frontend, used in email links (default: first WEB_ORIGIN)",
        "# APP_URL=https://app.example.com",
        "# Number of reverse proxies in front of the API (0 = clients connect directly)",
        "TRUST_PROXY=0",
        "# Email (verification + password reset). Without a key, emails are printed to the console.",
        "# Required when NODE_ENV=production.",
        "# RESEND_API_KEY=",
        "# EMAIL_FROM=App <noreply@your-domain.com>",
    ]
    test_lines = ["# Used by `npm test` (loaded in vitest.config.ts).", "NODE_ENV=test",
                  f"DATABASE_URL={test_db_url}", f"WEB_ORIGIN={a.web_origin}",
                  "# Tests send X-Forwarded-For so each test client gets its own rate-limit bucket",
                  "TRUST_PROXY=1"]
    if a.mongo:
        env_lines.append(f"MONGODB_URL=mongodb://127.0.0.1:{mongo_port}/app")
        test_lines.append(f"MONGODB_URL=mongodb://127.0.0.1:{mongo_port}/app_test")
    env_text = "\n".join(env_lines) + "\n"
    (dest / ".env.example").write_text(env_text)
    (dest / ".env").write_text(env_text)
    (dest / ".env.test").write_text("\n".join(test_lines) + "\n")
    if "docker" in active:
        (dest / "docker-compose.yml").write_text(compose_file(name, a.db, a.mongo, pg_port, mongo_port))

    rel_dest = Path(a.dir)
    ci_note = ""
    if not a.no_ci:
        wf = dest.parent / ".github" / "workflows" / f"{dest.name}.yml"
        if wf.exists():
            ci_note = f"\nCI: {wf} already exists; left unchanged."
        else:
            wf.parent.mkdir(parents=True, exist_ok=True)
            wf.write_text(ci_workflow(dest.name, a.db, a.mongo))
            ci_note = f"\nCI: wrote {wf.relative_to(dest.parent)} (typecheck, migrations, tests, contract drift, audit, docker build)."
    print(f"Created {a.db}{' + mongo' if a.mongo else ''} API in {dest}")
    print("\nNext:")
    print(f"  cd {rel_dest} && npm install")
    if "docker" in active:
        print("  docker compose up -d --wait")
    print("  npm run db:generate && npm run db:migrate && npm test")
    print(f"  devctl start api --port {port} --cwd {rel_dest} -- npm run dev")
    print(f"  open http://localhost:{port}/api/docs")
    print("  commit drizzle/ and openapi.json (CI checks both are current)")
    if ci_note:
        print(ci_note)
    root = dest.parent
    for fe in sorted(root.iterdir()):
        if fe == dest or not fe.is_dir():
            continue
        if list(fe.glob("vite.config.*")):
            print(f"\nFrontend found at {fe.name}/ (Vite): add to vite.config server: "
                  f"{{ proxy: {{ '/api': 'http://localhost:{port}' }} }}")
        elif list(fe.glob("next.config.*")):
            print(f"\nFrontend found at {fe.name}/ (Next.js): add rewrites "
                  f"[{{ source: '/api/:path*', destination: 'http://localhost:{port}/api/:path*' }}]")


if __name__ == "__main__":
    main()
