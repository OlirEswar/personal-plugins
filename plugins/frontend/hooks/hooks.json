{
  "description": "Format edited web files with the project's own formatter (Biome or Prettier) if it has one.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/format-edited-file.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
